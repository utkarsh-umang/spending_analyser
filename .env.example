ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional: ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# GPT agent for uncertain transactions (before human HITL)
OPENAI_API_KEY=your_openai_key_here
# Optional: OPENAI_MODEL=gpt-4o
# HITL_AGENT_ENABLED=true
# HITL_AGENT_CONFIDENCE_THRESHOLD=0.75

# Web search: OpenAI's built-in search (default, no extra keys)
# OPENAI_NATIVE_WEB_SEARCH=true

# Only if OPENAI_NATIVE_WEB_SEARCH=false — custom search fallback:
# GOOGLE_API_KEY= + GOOGLE_CSE_ID=  (optional Google Programmable Search)
# otherwise DuckDuckGo is used automatically
